+unsigned __int64 CTrafficMonitorDlg::GetWlanLinkSpeed(DWORD if_index)
+{
+    //GetIfTable中的dwSpeed字段对于无线网卡来说通常不准确（可能是网卡的标称/理论速度，而不是当前实际协商的速度）
+    //“WLAN状态”对话框中显示的“速度”实际上是通过WLAN API获取的，这里用同样的方法获取，以保证数值完全一致
+    //先将IPv4接口索引转换为接口LUID，再转换为WLAN API所需要的接口GUID
+    NET_LUID luid{};
+    if (ConvertInterfaceIndexToLuid(if_index, &luid) != NO_ERROR)
+        return 0;
+    GUID if_guid{};
+    if (ConvertInterfaceLuidToGuid(&luid, &if_guid) != NO_ERROR)
+        return 0;
+
+    HANDLE hClient{};
+    DWORD cur_version{};
+    if (WlanOpenHandle(2, nullptr, &cur_version, &hClient) != ERROR_SUCCESS)
+        return 0;
+
+    unsigned __int64 speed_bps{};
+    PWLAN_CONNECTION_ATTRIBUTES connect_info{};
+    DWORD data_size{};
+    if (WlanQueryInterface(hClient, &if_guid, wlan_intf_opcode_current_connection, nullptr, &data_size, (PVOID*)&connect_info, nullptr) == ERROR_SUCCESS
+        && connect_info != nullptr)
+    {
+        if (connect_info->isState == wlan_interface_state_connected)
+        {
+            //ulTxRate的单位为Kbps（千比特每秒），与“WLAN状态”对话框中显示的“速度”一致
+            speed_bps = static_cast<unsigned __int64>(connect_info->wlanAssociationAttributes.ulTxRate) * 1000ull;
+        }
+        WlanFreeMemory(connect_info);
+    }
+
+    WlanCloseHandle(hClient, nullptr);
+    return speed_bps;
+}
